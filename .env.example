# ============ FamGate configuration (copy to .env) ============
# Host/port
HOST=0.0.0.0
PORT=8000

# --- SMTP (for signup OTP emails, payment receipts, notifications) ---
# Gmail: use smtp.gmail.com:587 + a 16-char App Password (myaccount.google.com → Security → App passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM=you@gmail.com
SMTP_TLS=1
# SMTP_TLS=0 + port 465 uses SSL instead of STARTTLS

# --- Background verification poll interval (seconds, min 3) ---
FAMGATE_POLL_SECONDS=8

# --- Optional: custom encryption key for the credential vault (Fernet key, 44-char base64).
#     If unset, one is generated on first run at data/vault.key (chmod 600). ---
# FAMGATE_VAULT_KEY=

# --- DEV ONLY: allow webhook URLs on localhost / private LAN IPs. ---
# Default 0 = strict SSRF guard (public http(s) endpoints only). Set 1 when testing locally.
# FAMGATE_WEBHOOK_ALLOW_PRIVATE=0

# --- Storage locations (defaults are fine for most setups) ---
# FAMGATE_DATA_DIR=./data
# FAMGATE_DB=./data/famgate.db
